{
  "info": {
    "name": "Express Lab 3 - Clean REST API with Filtering, Sorting, Validation, and Debugging",
    "description": "Postman Collection for Express Lab 3 covering RESTful CRUD, query filters (search_q, order_by, order, limit, offset, min_price, max_price), request body validation, and standard HTTP status codes. Run it top to bottom with the Collection Runner: request 09 saves the new book id in {{bookId}} and requests 10, 12 and 13 use it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "bookId",
      "value": "11",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. GET /books - All Books (Default Parameters)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Returns an array', () => pm.expect(json).to.be.an('array'));",
              "pm.test('Default limit of 10 respected', () => pm.expect(json.length).to.be.at.most(10));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        }
      }
    },
    {
      "name": "02. GET /books - Search with LIKE (?search_q=Gatsby)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Every title contains Gatsby', () => json.forEach(b => pm.expect(b.title).to.include('Gatsby')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?search_q=Gatsby",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "search_q",
              "value": "Gatsby"
            }
          ]
        }
      }
    },
    {
      "name": "03. GET /books - Sorting (?order_by=price&order=DESC&limit=4)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Sorted by price high to low', () => { const p = json.map(b => b.price); pm.expect(p).to.eql([...p].sort((a, b) => b - a)); });",
              "pm.test('At most 4 rows', () => pm.expect(json.length).to.be.at.most(4));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?order_by=price&order=DESC&limit=4",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "order_by",
              "value": "price"
            },
            {
              "key": "order",
              "value": "DESC"
            },
            {
              "key": "limit",
              "value": "4"
            }
          ]
        }
      }
    },
